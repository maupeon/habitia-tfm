FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY servicio/requirements_v3.txt servicio/requirements_v3.txt
RUN pip install --no-cache-dir -r servicio/requirements_v3.txt
COPY predictor_v3/ predictor_v3/
COPY servicio/api_v3.py servicio/api_v3.py
COPY servicio/manifiesto_v3.json servicio/manifiesto_v3.json
COPY servicio/artefactos_v3/ servicio/artefactos_v3/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
USER 65532:65532
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/salud', timeout=3)"
CMD ["uvicorn", "servicio.api_v3:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
